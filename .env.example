# Set to the externally visible HTTPS origin and hostname for passkeys.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Zero Trust Identity Mesh
WEBAUTHN_ORIGIN=https://localhost

# Comma-separated administrator DIDs. Leave empty until an admin DID is known.
IDP_ADMIN_DIDS=

# Add browser origins that call the API directly. The same-origin dashboard needs none.
ALLOWED_ORIGINS=https://localhost

# Local development storage paths. Compose overrides these for its persistent volume.
LEDGER_STORAGE_PATH=data/ledger.json
AUDIT_DB_PATH=data/security_events.sqlite3
WEBAUTHN_DB_PATH=data/webauthn.sqlite3
DID_REGISTRY_PATH=data/did_registry.json
TOKEN_KEY_DIR=data/token_keys
