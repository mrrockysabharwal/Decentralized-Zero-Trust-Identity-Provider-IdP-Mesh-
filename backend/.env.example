# ==============================================================================
# TrustMesh: Decentralized Zero-Trust Identity Provider Configuration
# ==============================================================================

# WebAuthn / FIDO2 Relying Party Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Zero Trust Identity Mesh"
WEBAUTHN_ORIGIN=http://localhost:8000
WEBAUTHN_DB_PATH=backend/webauthn.sqlite3

# OpenID Connect (OIDC) Identity Provider Settings
OIDC_ISSUER=http://127.0.0.1:8000/oidc
OIDC_DB_PATH=backend/webauthn.sqlite3
OIDC_DEBUG=0

# Blockchain Ledger Persistence Path
LEDGER_STORAGE_PATH=data/ledger.json
